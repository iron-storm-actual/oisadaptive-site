body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #07090D;
    color: #E6E6E6;
}

.container {
    max-width: 900px;
    margin: auto;
    padding: 100px 20px;
}

h1 {
    font-size: 3em;
    margin-bottom: 20px;
    color: #FF7A00;
}

h2 {
    margin-top: 60px;
    color: #00C26E;
}

.button {
    display: inline-block;
    margin-top: 30px;
    padding: 14px 28px;
    background-color: #FF7A00;
    color: #07090D;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 700;
}

.button:hover {
    background-color: #00C26E;
    color: #07090D;
}

footer {
    margin-top: 100px;
    font-size: 0.9em;
    opacity: 0.6;
}
